# Production & Build Outputs
# ==========================================
dist/
build/
out/
out-tsc/
bazel-out/

# TypeScript cache
*.tsbuildinfo

# ==========================================
# Angular Specifics
# ==========================================
.angular/
.angular/cache/

# ==========================================
# Environment Variables & Secrets (NEVER COMMIT)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

