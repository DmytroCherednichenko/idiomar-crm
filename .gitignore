# VS Code (ignore user workspace settings, preserve project recommendations)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ==========================================
# Temporary & Cache Directories
